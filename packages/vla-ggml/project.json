{
  "name": "@qvac/vla-ggml",
  "root": "packages/vla-ggml",
  "tags": ["ci:contract"],
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint", "cwd": "packages/vla-ggml" }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test:dts", "cwd": "packages/vla-ggml" }
    },
    "test:unit": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test:unit", "cwd": "packages/vla-ggml" }
    },
    "verify:generated": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run check:generated", "cwd": "packages/vla-ggml" }
    },
    "ci:setup": {
      "executor": "nx:run-commands",
      "options": { "command": "node ci/configure-registries.mjs", "cwd": "packages/vla-ggml" }
    },
    "build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run build", "cwd": "packages/vla-ggml" },
      "inputs": ["default", "!{projectRoot}/prebuilds/**"],
      "outputs": ["{projectRoot}/prebuilds"],
      "metadata": {
        "artifactNamePrefix": "vla-",
        "linuxExtraPackages": "libxi-dev libxtst-dev libxrandr-dev"
      }
    },
    "cpp:lint": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run lint:cpp", "cwd": "packages/vla-ggml" },
      "metadata": {
        "runners": ["linux_ubuntu2204_x64"],
        "timeoutMinutes": 120,
        "includeRocmSdk": true
      }
    },
    "cpp:build": {
      "executor": "nx:run-commands",
      "options": { "command": "pnpm run test:cpp:build", "cwd": "packages/vla-ggml" },
      "metadata": {
        "runners": ["linux_ubuntu2404_x64", "macos_arm64_gpu", "macos_15_intel", "win_2025_x64"],
        "mode": "standard",
        "windowsVsGenerator": true
      }
    },
    "cpp:tests": {
      "executor": "nx:run-commands",
      "options": { "command": "node ci/run-cpp-tests.mjs", "cwd": "packages/vla-ggml" },
      "metadata": { "timeoutMinutes": 60 }
    },
    "test:integration": {
      "executor": "nx:run-commands",
      "options": { "command": "node ci/run-integration.mjs", "cwd": "packages/vla-ggml" },
      "metadata": {
        "runners": [
          "linux_ubuntu2204_x64",
          "linux_ubuntu2404_x64_gpu",
          "ubuntu_2204_arm",
          "ubuntu_2404_arm",
          "macos_arm64_gpu",
          "macos_15_large",
          "win_2025_x64_gpu"
        ],
        "linuxArmApt": ["mesa-vulkan-drivers"],
        "tolerateSigsegv": true
      }
    },
    "test:backend": {
      "executor": "nx:run-commands",
      "options": { "command": "node ci/run-backend.mjs", "cwd": "packages/vla-ggml" },
      "metadata": { "runners": ["linux_ubuntu2404_x64_gpu"] }
    },
    "test:mobile": {
      "executor": "nx:run-commands",
      "options": { "command": "node ci/prepare-mobile.mjs", "cwd": "packages/vla-ggml" },
      "metadata": {
        "devicefarmSecrets": "LLAMACPP_EMBED",
        "enablesPerf": true,
        "mochaTimeoutMs": 4200000,
        "perTestTimeoutMinutes": { "Android": 60 },
        "perfReport": { "title": "VLA Mobile Performance Report", "merge": true }
      }
    },
    "cache:models": {
      "executor": "nx:noop"
    },
    "publish": {
      "executor": "nx:noop",
      "metadata": {
        "nameTransform": "none",
        "repoName": "vla",
        "testGateMode": "none",
        "npmTagOverride": "latest"
      }
    }
  },
  "implicitDependencies": ["inference-addon-cpp", "lint-cpp", "qvac-addon-cmake"]
}
