{
  "name": "@qvac/fabric-llm-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Browser WebGPU proof of concept for the fabric LLM engine",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/client.js"
  },
  "files": [
    "src",
    "dist",
    "!dist/*.test.mjs",
    "!dist/baseline",
    "!dist/batch1",
    "demo",
    "README.md",
    "source-lock.json",
    "patches",
    "scripts"
  ],
  "scripts": {
    "build": "node scripts/build.mjs --compat",
    "test": "node --test test/*.test.js",
    "demo": "node demo/server.mjs",
    "download:model": "node scripts/download-model.mjs",
    "package:browser": "node scripts/package-browser-sdk.mjs",
    "verify:browser-package": "node scripts/package-browser-sdk.mjs --verify"
  },
  "devDependencies": {
    "esbuild": "0.28.1",
    "fast-safe-stringify": "2.1.1",
    "typescript": "5.9.3",
    "zod": "4.6.5"
  }
}
