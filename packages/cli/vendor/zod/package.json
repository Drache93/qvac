{
  "name": "zod",
  "version": "4.6.5",
  "type": "module",
  "license": "MIT",
  "author": "Colin McDonnell <zod@colinhacks.com>",
  "description": "TypeScript-first schema declaration and validation library with static type inference",
  "homepage": "https://github.com/tetherto/zod",
  "sideEffects": [
    "./compile.js",
    "./compile.cjs"
  ],
  "files": [
    "**/*.js",
    "**/*.cjs",
    "**/*.d.ts",
    "**/*.d.cts",
    "**/package.json",
    "LICENSE",
    "NOTICE.md",
    "PROVENANCE.json"
  ],
  "keywords": [
    "typescript",
    "schema",
    "validation",
    "type",
    "inference"
  ],
  "main": "./index.cjs",
  "types": "./index.d.cts",
  "module": "./index.js",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./index.d.cts",
      "import": "./index.js",
      "require": "./index.cjs"
    },
    "./mini": {
      "types": "./mini/index.d.cts",
      "import": "./mini/index.js",
      "require": "./mini/index.cjs"
    },
    "./compile": {
      "types": "./compile.d.cts",
      "import": "./compile.js",
      "require": "./compile.cjs"
    },
    "./locales": {
      "types": "./locales/index.d.cts",
      "import": "./locales/index.js",
      "require": "./locales/index.cjs"
    },
    "./v3": {
      "types": "./v3/index.d.cts",
      "import": "./v3/index.js",
      "require": "./v3/index.cjs"
    },
    "./v4": {
      "types": "./v4/index.d.cts",
      "import": "./v4/index.js",
      "require": "./v4/index.cjs"
    },
    "./v4-mini": {
      "types": "./v4-mini/index.d.cts",
      "import": "./v4-mini/index.js",
      "require": "./v4-mini/index.cjs"
    },
    "./v4/mini": {
      "types": "./v4/mini/index.d.cts",
      "import": "./v4/mini/index.js",
      "require": "./v4/mini/index.cjs"
    },
    "./v4/core": {
      "types": "./v4/core/index.d.cts",
      "import": "./v4/core/index.js",
      "require": "./v4/core/index.cjs"
    },
    "./v4/locales": {
      "types": "./v4/locales/index.d.cts",
      "import": "./v4/locales/index.js",
      "require": "./v4/locales/index.cjs"
    },
    "./v4/locales/*": {
      "types": "./v4/locales/*",
      "import": "./v4/locales/*",
      "require": "./v4/locales/*"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tetherto/zod.git"
  },
  "bugs": {
    "url": "https://github.com/tetherto/zod/issues"
  },
  "x-qvac-fork": {
    "upstream": "https://github.com/colinhacks/zod",
    "tag": "v4.6.5",
    "commit": "59bbc03e10c636b9eb3c393dfeb552819774ec21",
    "integrity": "sha512-v5l/aFXZQeai4awLbOpSoHecE9UiMrnfx75tEXLjNonXVARxQ5mOeipTjROUchszUNCqnE+hqAMujRsRHsut2Q==",
    "changes": [
      "Library-only runtime distribution; original zod specifier and version retained for SDK/Core/Harness compatibility.",
      "No parser, validator or schema behavior changes."
    ]
  }
}
