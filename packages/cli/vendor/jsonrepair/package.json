{
  "name": "jsonrepair",
  "version": "3.15.0",
  "description": "Repair broken JSON documents",
  "repository": {
    "type": "git",
    "url": "https://github.com/josdejong/jsonrepair.git"
  },
  "type": "module",
  "main": "lib/cjs/index.js",
  "module": "lib/esm/index.js",
  "browser": "lib/umd/jsonrepair.min.js",
  "types": "lib/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "import": "./lib/esm/index.js",
      "require": "./lib/cjs/index.js",
      "types": "./lib/types/index.d.ts"
    },
    "./stream": {
      "import": "./lib/esm/stream.js",
      "require": "./lib/cjs/stream.js",
      "types": "./lib/types/stream.d.ts"
    }
  },
  "keywords": [
    "simple",
    "json",
    "repair",
    "fix",
    "invalid",
    "stream",
    "streaming"
  ],
  "files": [
    "**/*"
  ],
  "author": "Jos de Jong",
  "license": "ISC",
  "x-qvac-fork": {
    "upstream": {
      "type": "git",
      "url": "https://github.com/josdejong/jsonrepair.git"
    },
    "version": "3.15.0",
    "integrity": "sha512-wy8OTjwsJwQRnQJkKnMJJ9vcytRdBPAgIF/Hy6+s1dAj42BHMKiyL8JzEieIl3JY7idt8eyHwBWTO8mh/+mtwA==",
    "changes": [
      "Library-only distribution; runtime changes, if any, are recorded as exact patches in PROVENANCE.json.",
      "Bundled local snapshot; no remote fork or registry publication required."
    ]
  }
}
