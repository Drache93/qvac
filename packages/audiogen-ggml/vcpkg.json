{
  "dependencies": [
    {
      "name": "ggml-speech",
      "default-features": false
    },
    {
      "name": "qvac-lib-inference-addon-cpp",
      "version>=": "1.5.0"
    },
    {
      "name": "qvac-lint-cpp",
      "version>=": "1.4.4#3"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "audiogen",
        "metal"
      ],
      "platform": "ios"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "audiogen",
        "metal",
        "minimax-coreml"
      ],
      "platform": "osx"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "audiogen",
        "opencl",
        "vulkan"
      ],
      "platform": "android"
    },
    {
      "name": "speech-cpp",
      "default-features": false,
      "features": [
        "audiogen",
        "vulkan"
      ],
      "platform": "!(osx | ios | android)"
    }
  ],
  "features": {
    "cuda": {
      "description": "Enable CUDA GPU acceleration",
      "supports": "!(osx | ios | android)",
      "dependencies": [
        {
          "name": "speech-cpp",
          "default-features": false,
          "features": [
            "cuda"
          ],
          "platform": "!(osx | ios | android)"
        }
      ]
    },
    "fuzz": {
      "description": "Build fuzz targets (Google FuzzTest dependencies)",
      "dependencies": [
        {
          "name": "abseil",
          "features": [
            "asan"
          ],
          "version>=": "20260526.0"
        },
        "antlr4",
        {
          "name": "fuzztest",
          "features": [
            "asan"
          ],
          "version>=": "2026-06-29"
        },
        "gtest",
        {
          "name": "re2",
          "features": [
            "asan"
          ],
          "version>=": "2025-11-05"
        }
      ]
    },
    "tests": {
      "description": "Build C++ unit tests",
      "dependencies": [
        "gtest"
      ]
    },
    "vulkan": {
      "description": "Enable Vulkan GPU acceleration",
      "dependencies": [
        {
          "name": "speech-cpp",
          "default-features": false,
          "features": [
            "vulkan"
          ],
          "platform": "!(osx | ios)"
        }
      ]
    }
  },
  "overrides": [
    {
      "name": "ggml-speech",
      "version": "2026-10-23"
    },
    {
      "name": "speech-cpp",
      "version": "2026-10-23#3"
    }
  ]
}
